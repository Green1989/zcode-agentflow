{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plan-proposal.schema.json",
  "title": "plan-proposal (RAW planner-result wrapper, model-emitted)",
  "description": "The planner-result wrapper (P0-5): lets a multi-task goal fail cleanly at validation. What Codex emits from planner_create_plan. RAW: FORBIDS authoritative fields (run_id, base_commit, plan_version, hashes). status is READY_FOR_EXECUTION (clean plan) | NEEDS_USER_INPUT (open questions) | BLOCKED. The plan (when present) is a strict SINGLE-task plan WITHOUT base_commit/run_id — the engine injects those into the FINAL plan-envelope. (Task 2.1, P0-5, parallel P0-4.)",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["READY_FOR_EXECUTION", "NEEDS_USER_INPUT", "BLOCKED"]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_markdown", "tasks"],
      "properties": {
        "plan_markdown": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/definitions/rawTask" }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "block_reason": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "taskId": {
      "type": "string",
      "pattern": "^T[0-9]{3}(-R[0-9]+)?$",
      "description": "task id: T000 / T000-R0 form (inlined from spec-envelope so this RAW schema is self-contained — model-API response_format validators do not resolve cross-file $ref)."
    },
    "rawTask": {
      "type": "object",
      "additionalProperties": false,
      "description": "Single task as the model emits it — NO base_commit/run_id (engine injects).",
      "required": ["id", "title", "dependencies", "declared_files",
                   "verification_commands", "acceptance_criteria", "planned_changes"],
      "properties": {
        "id": { "$ref": "#/definitions/taskId" },
        "title": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "declared_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "verification_commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/verificationCommand" }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "planned_changes": { "$ref": "#/definitions/plannedChanges" }
      }
    },
    "verificationCommand": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structured verification command (P1-5): NOT an arbitrary shell string. kind chooses the execution path; program is exec'd (or interpreted for script kinds).",
      "required": ["kind", "program", "args", "cwd", "timeout_sec"],
      "properties": {
        "kind": { "type": "string", "enum": ["executable", "cmd_script", "bash_script"] },
        "program": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "timeout_sec": { "type": "integer", "minimum": 1 }
      }
    },
    "plannedChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_add_dependencies", "may_run_migrations", "may_delete_files"],
      "properties": {
        "may_add_dependencies": { "type": "boolean" },
        "may_run_migrations": { "type": "boolean" },
        "may_delete_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
