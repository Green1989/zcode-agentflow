# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- Testing / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- Type checkers ----
.mypy_cache/
.ruff_cache/
.pytype/

# ---- AgentFlow runtime artifacts (generated, never committed) ----
# state, events, operations, reviews, worktrees live outside the repo at runtime,
# but guard against any accidental local ones:
.agentflow/
**/state.json
**/events.jsonl
operations/
approvals/
reviews/
plan-history/
raw/

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- OS ----
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Secrets ----
.env
.env.*
*.pem
*.key
secrets.json

# ---- Phase 0 spike / AgentFlow control_root (never committed) ----
# Spike scripts, raw CLI outputs, hook logs, and the runtime control_root live
# OUTSIDE the repo by design. These patterns guard against accidental inclusion.
# IMPORTANT: do NOT add a broad `prompts/` rule (see AGENTS.md G1) — prompts are
# source files here. These patterns target spike/control_root artifacts only.
spike/
**/spike-out/
control_root/
.agentflow-control/
**/hooks.jsonl
**/spike-*.jsonl
**/bundle_checksums_*.txt

# ---- ZCode tool runtime (NOT source) ----
# .zcode/ is the ZCode IDE/tool runtime directory created in the repo root
# (plan caches, session artifacts). It is generated tooling state, never source.
# Scoped to the repo root (leading slash) so a same-named subdir under src/
# (none currently) would not be affected.
/.zcode/